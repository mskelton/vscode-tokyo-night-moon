{
  "name": "tokyo-night-moon",
  "displayName": "Tokyo Night Moon",
  "description": "VSCode theme inspired by Folke's Tokyo Night Moon theme",
  "version": "1.1.2",
  "publisher": "mskelton",
  "license": "ISC",
  "keywords": [
    "theme",
    "contrast",
    "dark",
    "light",
    "tokyo",
    "moon",
    "clean"
  ],
  "icon": "icon.png",
  "homepage": "https://github.com/mskelton/vscode-tokyo-night-moon",
  "repository": {
    "url": "https://github.com/mskelton/vscode-tokyo-night-moon",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/mskelton/vscode-tokyo-night-moon/issues"
  },
  "galleryBanner": {
    "color": "#1f2335",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.17.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Tokyo Night Moon",
        "uiTheme": "vs-dark",
        "path": "./themes/tokyo-night-moon-color-theme.json"
      }
    ]
  },
  "type": "module",
  "scripts": {
    "create-theme": "node ./scripts/create-theme.js",
    "fmt": "prettier --write .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
